#!/usr/bin/env python3
"""paginar — notebook Jupyter ou HTML pronto em PDF paginado, sem LaTeX.

    paginar caderno.ipynb          # PDF ao lado do notebook
    paginar pasta/                 # todos os .ipynb da pasta
    paginar caderno.ipynb --retrato
    paginar caderno.ipynb --sem-codigo
    paginar curriculo.html         # HTML impresso como está

Imprime as saídas já salvas no arquivo; não executa nada. Se o notebook estiver
sem saídas, rode antes: jupyter nbconvert --to notebook --execute --inplace.

Notebook é convertido, recebe um CSS de impressão e sai com margem e rodapé.
HTML entra sem conversão e sem CSS injetado: quem o escreveu já decidiu `@page`
e margem, e um rodapé desenhado por cima disso cobriria o conteúdo.

As dependências ficam em um ambiente isolado no cache do usuário. A primeira
execução prepara o ambiente; as seguintes reutilizam o que já foi instalado.
Um único navegador atende todos os arquivos do lote.
"""
import argparse
from html import escape
import importlib.util
import json
import os
import pathlib
import subprocess
import sys
import tempfile

# Paisagem porque tabela larga de DataFrame corta na direita em retrato.
# A escala de 0.8 no page.pdf() dá a folga restante.
CSS = """
<style>
@page {{ size: A4 {orientacao}; }}
body {{ max-width: none !important; }}
.jp-Notebook {{ padding: 0 !important; }}
.jp-InputArea, .jp-OutputArea-child {{ break-inside: avoid-page; }}
h1, h2, h3 {{ break-after: avoid-page; }}
.jp-RenderedImage img {{ max-width: 100% !important; height: auto !important; }}
table {{ font-size: 0.82em; }}
pre, code {{ font-size: 0.85em; }}
</style>
"""

RODAPE = """
<div style="width:100%;font-size:8px;color:#666;padding:0 14mm;
            font-family:system-ui,sans-serif;display:flex;justify-content:space-between;">
  <span>{titulo}</span><span class="pageNumber"></span>
</div>
"""


def reexecutar(pacotes):
    """Reutiliza um venv no cache e instala somente dependências ausentes."""
    cache = pathlib.Path(os.environ.get('XDG_CACHE_HOME', pathlib.Path.home() / '.cache'))
    venv = cache / 'paginar' / f'python{sys.version_info.major}.{sys.version_info.minor}'
    python = venv / 'bin/python'
    if not python.exists():
        subprocess.run([sys.executable, '-m', 'venv', str(venv)], check=True)
    consulta = ('import importlib.util, sys; '
                'sys.exit(not importlib.util.find_spec(sys.argv[1]))')
    faltam = [pacote for pacote in pacotes if subprocess.run(
        [python, '-c', consulta, pacote], capture_output=True).returncode]
    if faltam:
        print('preparando ambiente isolado (reutilizado nas próximas execuções)...',
              file=sys.stderr)
        subprocess.run([python, '-m', 'pip', 'install', '-q', *faltam], check=True)
        if 'playwright' in faltam:
            subprocess.run([python, '-m', 'playwright', 'install', 'chromium-headless-shell'],
                           check=True)
    return subprocess.run([python, os.path.abspath(__file__), *sys.argv[1:]]).returncode


def arquivos(entradas):
    """Valida entradas antes da conversão; pastas incluem somente notebooks."""
    alvos, erros = [], []
    for entrada in entradas:
        caminho = pathlib.Path(entrada).expanduser().resolve()
        if caminho.is_dir():
            encontrados = sorted(caminho.glob('*.ipynb'))
            if not encontrados:
                erros.append(f'pasta sem notebooks: {caminho}')
            alvos.extend(encontrados)
        elif not caminho.is_file():
            erros.append(f'arquivo não encontrado: {caminho}')
        elif caminho.suffix.lower() in ('.ipynb', '.html'):
            alvos.append(caminho)
        else:
            erros.append(f'formato não aceito: {caminho}')
    unicos, destinos = [], set()
    for alvo in dict.fromkeys(alvos):
        destino = alvo.with_suffix('.pdf')
        if destino in destinos:
            erros.append(f'dois documentos gerariam o mesmo PDF: {destino}')
        else:
            destinos.add(destino)
            unicos.append(alvo)
    return unicos, erros


def titulo_do_notebook(nb):
    """Primeiro título de nível 1 do notebook; sem ele, o nome do arquivo.

    O nbformat aceita `source` como lista de linhas ou como string única, e as
    duas formas aparecem conforme quem salvou o arquivo. O join cobre as duas:
    numa string, devolve a própria string.
    """
    for celula in json.loads(nb.read_text(encoding='utf-8'))['cells']:
        if celula['cell_type'] == 'markdown':
            for linha in ''.join(celula['source']).splitlines():
                if linha.startswith('# '):
                    return linha[2:].strip()
    return nb.stem.replace('-', ' ')


def gerar(entrada, orientacao, navegador, exportador=None):
    """Renderiza um documento; só substitui o PDF quando a impressão termina."""
    html, temporario, pagina, pdf_temporario = entrada, None, None, None
    pdf = entrada.with_suffix('.pdf')
    try:
        if entrada.suffix.lower() == '.html':
            extras = {'scale': 1,
                      'margin': dict.fromkeys(('top', 'bottom', 'left', 'right'), '0')}
        else:
            conteudo, _ = exportador.from_filename(str(entrada))
            with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8',
                    prefix='.paginar-', suffix='.paginar.html',
                    dir=entrada.parent, delete=False) as arquivo:
                temporario = html = pathlib.Path(arquivo.name)
                arquivo.write(conteudo.replace(
                    '</head>', CSS.format(orientacao=orientacao) + '</head>', 1))
            extras = {
                'scale': 0.8,
                'display_header_footer': True,
                'header_template': '<span></span>',
                'footer_template': RODAPE.format(titulo=escape(titulo_do_notebook(entrada))),
                'margin': {'top': '10mm', 'bottom': '12mm', 'left': '12mm', 'right': '12mm'},
            }
        with tempfile.NamedTemporaryFile(prefix='.paginar-', suffix='.pdf',
                                         dir=entrada.parent, delete=False) as arquivo:
            pdf_temporario = pathlib.Path(arquivo.name)
        pagina = navegador.new_page()
        pagina.goto(html.as_uri(), wait_until='networkidle')
        pagina.pdf(path=str(pdf_temporario), prefer_css_page_size=True,
                   print_background=True, **extras)
        pdf_temporario.replace(pdf)
        return pdf
    finally:
        try:
            if pagina is not None:
                pagina.close()
        finally:
            for caminho in (temporario, pdf_temporario):
                if caminho is not None:
                    caminho.unlink(missing_ok=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('entradas', nargs='+', help='notebooks, HTMLs ou pastas')
    ap.add_argument('--retrato', action='store_true', help='A4 em pé em vez de deitado')
    ap.add_argument('--sem-codigo', action='store_true', help='esconde as células de código')
    args = ap.parse_args()

    alvos, erros = arquivos(args.entradas)
    if not alvos:
        for erro in erros:
            print(erro, file=sys.stderr)
        return 1

    pacotes = ['playwright']
    if any(alvo.suffix.lower() == '.ipynb' for alvo in alvos):
        pacotes.append('nbconvert')
    if not all(importlib.util.find_spec(pacote) for pacote in pacotes):
        return reexecutar(pacotes)

    for erro in erros:
        print(erro, file=sys.stderr)

    from playwright.sync_api import Error, sync_playwright

    exportador = None
    if 'nbconvert' in pacotes:
        from nbconvert import HTMLExporter
        exportador = HTMLExporter(
            embed_images=True, exclude_input=args.sem_codigo,
            exclude_input_prompt=args.sem_codigo, exclude_output_prompt=args.sem_codigo)

    with sync_playwright() as p:
        try:
            navegador = p.chromium.launch()
        except Error as erro:
            print(f'não foi possível abrir o Chromium: {erro}\n'
                  f'Para instalar: {sys.executable} -m playwright install chromium-headless-shell',
                  file=sys.stderr)
            return 1
        try:
            for alvo in alvos:
                try:
                    pdf = gerar(alvo, 'portrait' if args.retrato else 'landscape',
                                navegador, exportador)
                    print(f'{pdf}  ({pdf.stat().st_size // 1024} KB)')
                except Exception as erro:
                    print(f'falha ao converter {alvo}: {erro}', file=sys.stderr)
                    erros.append(str(alvo))
        finally:
            navegador.close()
    return int(bool(erros))


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, subprocess.CalledProcessError) as erro:
        sys.exit(f'falha ao preparar o ambiente: {erro}')
