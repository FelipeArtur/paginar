#!/usr/bin/env python3
"""nb2pdf — notebook Jupyter ou HTML para PDF paginado, sem passar pelo Colab.

    nb2pdf caderno.ipynb                 # PDF ao lado do notebook
    nb2pdf pasta/                        # todos os .ipynb da pasta
    nb2pdf *.ipynb --out ~/entregas      # destino próprio
    nb2pdf caderno.ipynb --abrir         # abre o PDF ao terminar
    nb2pdf caderno.ipynb --sem-codigo    # só texto e resultados
    nb2pdf caderno.ipynb --retrato       # A4 em pé
    nb2pdf pagina.html --escala 1        # HTML pronto, do jeito que está

Imprime as saídas já salvas no arquivo; não executa nada. Se o notebook
estiver sem saídas, rode-o antes (jupyter nbconvert --execute --inplace).

Notebook e HTML seguem caminhos diferentes de propósito. Notebook é convertido,
recebe um CSS de impressão e ganha margem e rodapé com título e número de
página. HTML já é o documento final: entra sem conversão, sem CSS injetado, sem
margem imposta e sem rodapé, porque quem o escreveu já decidiu `@page` e
margem, e um rodapé desenhado por cima disso sobreporia o conteúdo.

As dependências vão para um ambiente temporário, apagado assim que o PDF fica
pronto. Com --manter, o ambiente fica em ~/.local/share/nb2pdf e é reaproveitado
nas próximas execuções, o que troca 190 MB de disco por uns 20 segundos a menos
por execução. O navegador usado para imprimir fica no cache padrão do Playwright;
`nb2pdf --limpar` mostra como removê-lo.
"""
import argparse
import atexit
import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile

AMBIENTE = pathlib.Path.home() / '.local/share/nb2pdf/venv'
NAVEGADORES = pathlib.Path.home() / '.cache/ms-playwright'
PACOTES = ['nbconvert', 'playwright']
VAR_EFEMERO = 'NB2PDF_EFEMERO'

# Paisagem porque tabela larga de DataFrame corta na direita em retrato.
# A escala de 0.8 no page.pdf() dá a folga restante.
CSS = """
<style>
@page {{ size: A4 {orientacao}; }}
body {{ max-width: none !important; }}
.jp-Notebook {{ padding: 0 !important; }}
.jp-InputArea, .jp-OutputArea-child {{ break-inside: avoid-page; }}
h1, h2, h3 {{ break-after: avoid-page; }}
.jp-RenderedImage img {{ max-width: 100% !important; height: auto !important; }}
table {{ font-size: 0.82em; }}
pre, code {{ font-size: 0.85em; }}
</style>
"""

RODAPE = """
<div style="width:100%;font-size:8px;color:#666;padding:0 14mm;
            font-family:system-ui,sans-serif;display:flex;justify-content:space-between;">
  <span>{titulo}</span><span class="pageNumber"></span>
</div>
"""


def tamanho(caminho):
    if not caminho.exists():
        return '0 MB'
    total = sum(f.stat().st_size for f in caminho.rglob('*') if f.is_file())
    return f'{total // 1024 // 1024} MB'


def montar_ambiente(raiz):
    """Cria o venv em `raiz` e baixa só o navegador que a impressão usa."""
    subprocess.run([sys.executable, '-m', 'venv', str(raiz)], check=True)
    subprocess.run([raiz / 'bin/python', '-m', 'pip', 'install', '-q', *PACOTES], check=True)
    # chromium-headless-shell (262 MB) em vez de chromium (mais 389 MB que
    # nunca seriam abertos): page.pdf() roda no shell.
    subprocess.run([raiz / 'bin/playwright', 'install', 'chromium-headless-shell'], check=True)


def entrar_no_ambiente(manter):
    """Garante um ambiente utilizável e reexecuta o script dentro dele."""
    if sys.prefix.endswith('nb2pdf-venv') or pathlib.Path(sys.prefix) == AMBIENTE:
        return

    if AMBIENTE.exists():
        raiz, efemero = AMBIENTE, None
    elif manter:
        print(f'Montando o ambiente fixo em {AMBIENTE}', file=sys.stderr)
        AMBIENTE.parent.mkdir(parents=True, exist_ok=True)
        montar_ambiente(AMBIENTE)
        raiz, efemero = AMBIENTE, None
    else:
        print('Montando ambiente temporário (some ao final)...', file=sys.stderr)
        temporario = pathlib.Path(tempfile.mkdtemp(prefix='nb2pdf-'))
        raiz = temporario / 'nb2pdf-venv'
        montar_ambiente(raiz)
        efemero = temporario

    ambiente = dict(os.environ)
    if efemero:
        ambiente[VAR_EFEMERO] = str(efemero)
    os.execve(str(raiz / 'bin/python'),
              [str(raiz / 'bin/python'), os.path.abspath(__file__), *sys.argv[1:]], ambiente)


def apagar_efemero():
    alvo = os.environ.get(VAR_EFEMERO)
    if alvo:
        shutil.rmtree(alvo, ignore_errors=True)


def arquivos(entradas):
    """Notebooks e HTMLs a imprimir.

    Pasta rende só os `.ipynb`. HTML entra quando nomeado, e não por varredura:
    diretório de notebook costuma ter HTML de sobra (o próprio nbconvert deixa),
    e varrer transformaria lixo em PDF sem ninguém pedir.
    """
    for entrada in entradas:
        caminho = pathlib.Path(entrada).expanduser().resolve()
        if caminho.is_dir():
            yield from sorted(caminho.glob('*.ipynb'))
        elif caminho.suffix in ('.ipynb', '.html'):
            yield caminho
        else:
            print(f'ignorado (não é notebook nem HTML): {caminho}', file=sys.stderr)


def titulo_do_notebook(nb):
    """Primeiro título de nível 1 do notebook; sem ele, o nome do arquivo."""
    for celula in json.loads(nb.read_text())['cells']:
        if celula['cell_type'] == 'markdown':
            for linha in celula['source']:
                if linha.startswith('# '):
                    return linha[2:].strip()
    return nb.stem.replace('-', ' ')


def gerar(entrada, destino, orientacao, sem_codigo, escala):
    from playwright.sync_api import sync_playwright

    if entrada.suffix == '.html':
        # O documento manda. Sem conversão, sem CSS injetado, sem margem e sem
        # rodapé: quem escreveu o HTML já decidiu `@page` e margem, e o rodapé
        # do Playwright é desenhado na faixa de margem — com margem zero, ele
        # sairia por cima do conteúdo.
        html, temporario = entrada, False
        extras = {'margin': dict.fromkeys(('top', 'bottom', 'left', 'right'), '0')}
    else:
        venv = pathlib.Path(sys.prefix)
        html, temporario = destino / f'{entrada.stem}.nb2pdf.html', True
        comando = [venv / 'bin/jupyter', 'nbconvert', '--to', 'html', '--embed-images',
                   '--output', html.name, '--output-dir', str(destino), str(entrada)]
        if sem_codigo:
            comando.append('--no-input')
        subprocess.run(comando, check=True, capture_output=True)

        html.write_text(html.read_text().replace(
            '</head>', CSS.format(orientacao=orientacao) + '</head>', 1))
        extras = {
            'display_header_footer': True,
            'header_template': '<span></span>',
            'footer_template': RODAPE.format(titulo=titulo_do_notebook(entrada)),
            'margin': {'top': '10mm', 'bottom': '12mm', 'left': '12mm', 'right': '12mm'},
        }

    pdf = destino / f'{entrada.stem}.pdf'
    try:
        with sync_playwright() as p:
            navegador = p.chromium.launch()
            pagina = navegador.new_page()
            pagina.goto(html.as_uri(), wait_until='networkidle')
            pagina.pdf(path=str(pdf), prefer_css_page_size=True, print_background=True,
                       scale=escala, **extras)
            navegador.close()
    finally:
        if temporario:
            html.unlink(missing_ok=True)

    return pdf


def limpar():
    fixo = AMBIENTE.parent
    if fixo.exists():
        espaco = tamanho(fixo)
        shutil.rmtree(fixo)
        print(f'removido: {fixo} ({espaco})')
    else:
        print('nenhum ambiente fixo para remover')

    if NAVEGADORES.exists():
        print(f'\nO navegador da impressão fica em {NAVEGADORES} ({tamanho(NAVEGADORES)}).')
        print('Ele é compartilhado com qualquer outra ferramenta que use Playwright,')
        print('por isso não é apagado aqui. Para removê-lo:')
        print(f'    rm -rf {NAVEGADORES}')


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('entradas', nargs='*', help='notebooks, HTMLs ou pastas')
    ap.add_argument('--out', help='pasta de destino (padrão: ao lado do notebook)')
    ap.add_argument('--retrato', action='store_true', help='A4 em pé em vez de deitado')
    ap.add_argument('--sem-codigo', action='store_true', help='esconde as células de código')
    ap.add_argument('--escala', type=float, default=0.8, help='escala da impressão (padrão 0.8)')
    ap.add_argument('--abrir', action='store_true', help='abre o PDF no visualizador ao terminar')
    ap.add_argument('--manter', action='store_true',
                    help='guarda o ambiente em ~/.local/share/nb2pdf em vez de apagá-lo')
    ap.add_argument('--limpar', action='store_true',
                    help='remove o ambiente guardado e mostra como apagar o navegador')
    args = ap.parse_args()

    if args.limpar:
        limpar()
        return
    if not args.entradas:
        ap.error('informe ao menos um notebook ou pasta')

    entrar_no_ambiente(args.manter)
    atexit.register(apagar_efemero)

    alvos = list(arquivos(args.entradas))
    if not alvos:
        sys.exit('nenhum notebook nem HTML encontrado')

    for alvo in alvos:
        destino = pathlib.Path(args.out).expanduser().resolve() if args.out else alvo.parent
        destino.mkdir(parents=True, exist_ok=True)
        pdf = gerar(alvo, destino, 'portrait' if args.retrato else 'landscape',
                    args.sem_codigo, args.escala)
        print(f'{pdf}  ({pdf.stat().st_size // 1024} KB)')
        if args.abrir:
            subprocess.Popen(['xdg-open', str(pdf)],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == '__main__':
    main()
